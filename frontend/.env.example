# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo como .env (cp .env.example .env) y completá los valores.
# En Vercel, estas variables se cargan en Settings → Environment Variables.
#
# OJO: todo lo que empieza con VITE_ queda escrito en el JavaScript que descarga
# el navegador, o sea, es PÚBLICO. Nunca pongas un secreto en una variable VITE_.
# Y Vite las lee al arrancar o al hacer el build: si las cambiás, reiniciá
# npm run dev (o hacé Redeploy en Vercel).
# ─────────────────────────────────────────────────────────────────────────────

# La URL de la API, con /api al final. En Vercel: la URL de Render + /api
VITE_API_URL=http://localhost:4000/api

# 🔑 LOGIN CON GOOGLE · Paso 1 de la guía de lectura (README).
# El Client ID de Google Cloud Console (ver README). Es público: está bien que lo vea el navegador.
VITE_GOOGLE_CLIENT_ID=
