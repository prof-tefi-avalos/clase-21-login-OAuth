# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo como .env (cp .env.example .env) y completá los valores.
# El .env NO se sube a GitHub. En Render, estas mismas variables se cargan
# a mano en Environment.
# ─────────────────────────────────────────────────────────────────────────────

# Puerto de la API. En Render no hace falta: Render define PORT solo.
PORT=4000

# Dónde está la base. En tu compu: MongoDB local. En Render: la URI de Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/cine-demo

# Secreto para firmar NUESTROS tokens (JWT). Largo y al azar. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Desde qué URL acepta pedidos la API (CORS). En producción: la URL de Vercel,
# SIN barra final (https://mi-app.vercel.app, no https://mi-app.vercel.app/).
FRONTEND_URL=http://localhost:5173

# 🔑 LOGIN CON GOOGLE · Paso 1 de la guía de lectura (README).
# El Client ID de Google Cloud Console (ver README). Es el MISMO que usa el front.
# La API lo usa para comprobar que la credencial de Google fue emitida para esta app.
GOOGLE_CLIENT_ID=
